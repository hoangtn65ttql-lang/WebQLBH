@model WebQLBH.Models.PhanQuyen

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<h4>PhanQuyen</h4>
<hr />

<dl class="row">
    <dt class="col-sm-2">Mã Quyền</dt>
    <dd class="col-sm-10">@Model.MaQuyen</dd>

    <dt class="col-sm-2">Tên Quyền</dt>
    <dd class="col-sm-10">@(Model.Quyen?.TenQuyen ?? "")</dd>

    <dt class="col-sm-2">Nhân Viên</dt>
    <dd class="col-sm-10">@(Model.NhanVien?.HoNV + " " + Model.NhanVien?.TenNV)</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.MaQuyen">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>