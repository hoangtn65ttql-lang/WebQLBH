@model WebQLBH.Models.PhanQuyen

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>
<h4>PhanQuyen</h4>
<hr />

<div class="alert alert-danger">
    Bạn có chắc muốn xóa bản ghi này không?
</div>

<dl class="row">
    <dt class="col-sm-2">Mã Quyền</dt>
    <dd class="col-sm-10">@Model.MaQuyen</dd>

    <dt class="col-sm-2">Tên Quyền</dt>
    <dd class="col-sm-10">@(Model.Quyen?.TenQuyen ?? "")</dd>

    <dt class="col-sm-2">Nhân Viên</dt>
    <dd class="col-sm-10">@(Model.NhanVien?.HoNV + " " + Model.NhanVien?.TenNV)</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MaQuyen" />
    <input type="submit" value="Xóa" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>