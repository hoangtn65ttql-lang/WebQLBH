@model WebQLBH.Models.PhanQuyen

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>
<h4>PhanQuyen</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">

            <div class="form-group">
                <label asp-for="MaQuyen" class="control-label"></label>
                <select asp-for="MaQuyen" class="form-control" asp-items="ViewBag.MaQuyen">
                    <option value="">-- Chọn Quyền --</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="MaNV" class="control-label"></label>
                <select asp-for="MaNV" class="form-control" asp-items="ViewBag.MaNV">
                    <option value="">-- Chọn Nhân Viên --</option>
                </select>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}