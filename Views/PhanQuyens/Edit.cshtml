@model WebQLBH.Models.PhanQuyen

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>
<h4>PhanQuyen</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="MaQuyen" />

            <div class="form-group">
                <label asp-for="MaQuyen" class="control-label"></label>
                <input asp-for="MaQuyen" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="MaNV" class="control-label"></label>
                <select asp-for="MaNV" class="form-control" asp-items="ViewBag.MaNV">
                    <option value="">-- Chọn Nhân Viên --</option>
                </select>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>