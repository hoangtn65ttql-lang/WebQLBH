@model IEnumerable<WebQLBH.Models.PhanQuyen>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Mã Quyền</th>
            <th>Tên Quyền</th>
            <th>Nhân Viên</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaQuyen</td>
                <td>@(item.Quyen?.TenQuyen ?? "")</td>
                <td>@(item.NhanVien?.HoNV + " " + item.NhanVien?.TenNV)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MaQuyen">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.MaQuyen">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.MaQuyen">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>