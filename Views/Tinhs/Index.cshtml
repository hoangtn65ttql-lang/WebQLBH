@model IEnumerable<WebQLBH.Models.Tinh>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Mã Tỉnh
            </th>
            <th>
                Tên Tỉnh
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MaTinh)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TenTinh)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaTinh">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaTinh">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaTinh">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
